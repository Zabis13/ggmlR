#!/bin/sh

# Cleanup script for ggmlR package
# Removes compiled objects, shared libraries, and generated files

# Remove compiled objects and libraries
rm -f src/*.o src/*.so src/*.dll src/*.dylib src/*.a
rm -f inst/lib/*.a
rm -f src/ggml-cpu/*.o
rm -f src/onnx/*.o
rm -f src/ggml-cpu/arch/x86/*.o
rm -f src/ggml-cpu/arch/arm/*.o
rm -f src/ggml-cpu/llamafile/*.o
rm -f src/ggml-cpu/amx/*.o

# Remove Vulkan objects
rm -f src/ggml-vulkan/*.o
rm -f src/ggml-vulkan/generated/*.o
rm -f src/ggml-vulkan/vulkan-shaders/*.o

# Remove synced public headers (regenerated from src/ by configure)
rm -f inst/include/*.h

# Remove generated files created by configure
rm -f src/Makevars
rm -f src/Makevars.win

# Remove Vulkan generated files
rm -rf src/ggml-vulkan/generated
rm -f src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen

# Remove ONNX Runtime comparison dumps left by older checkouts.
#
# These now default to /tmp/ggmlR-ref/data and are NOT removed from there:
# a reference captured from ONNX Runtime costs a full run to reproduce, and
# deleting it as part of a build meant losing it exactly when a rebuild was
# about to be compared against it.  The paths below stay only to clean up
# trees that still have the old in-package directory.
rm -rf inst/scripts/ref_data
rm -rf inst/scripts/ref_depth
