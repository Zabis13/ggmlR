#version 450

#include "generic_head.glsl"
#include "types.glsl"

#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer G {A_TYPE data_g[];};
layout (binding = 1) readonly buffer X {B_TYPE data_x[];};
layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};

void main() {
    const float GELU_COEF_A    = 0.044715f;
    const float SQRT_2_OVER_PI = 0.79788456080286535587989211986876f;

    const uint i = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;

    if (i >= p.KX) {
        return;
    }

    // Derivative of the tanh approximation used by gelu.comp:
    //   g(x)  = 0.5*x*(1 + tanh(u)),  u = c*x*(1 + a*x^2)
    //   g'(x) = 0.5*(1 + tanh(u)) + 0.5*x*(1 - tanh(u)^2)*c*(1 + 3*a*x^2)
    //
    // tanh(u) is spelled out as 2/(exp(2u)+1) the same way gelu.comp does it,
    // which stays finite for large |u| where exp(u) alone would overflow.
    const float xi = float(data_x[i]);
    const float u  = SQRT_2_OVER_PI*xi*(1.0f + GELU_COEF_A*xi*xi);
    const float th = 1.0f - 2.0f / (exp(2.0f*u) + 1.0f);

    const float dg = 0.5f*(1.0f + th) +
                     0.5f*xi*(1.0f - th*th)*SQRT_2_OVER_PI*(1.0f + 3.0f*GELU_COEF_A*xi*xi);

    data_d[i] = D_TYPE(float(data_g[i]) * dg);
}
